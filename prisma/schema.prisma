// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  username       String   @unique
  hashedPassword String
  name           String?
  createdAt      DateTime @default(now())
}

model Organisation {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  username       String        @unique
  hashedPassword String
  name           String        @unique
  walletAddress  String?       @unique // Organization wallet address from blockchain
  contractAddress String?      @unique // Certificate contract address from blockchain
  metadata       String?       // Additional metadata from blockchain
  isActive       Boolean       @default(true)
  isFlagged      Boolean       @default(false)
  issuedCertCount Int          @default(0)
  certificates   Certificate[]
  courses        Course[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Certificate {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  certificateId  String // your certificate unique ID
  name           String
  nqrCode       String? // the NQR Code(courseId to be specific)
  courseName     String?
  organisationId String       @db.ObjectId
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  apaarId        String? // Simple string field to link to user when they exist
  year           String?
  url            String
  createdAt      DateTime     @default(now())

  @@index([nqrCode])
  @@index([apaarId]) // Index for fast certificate lookups by APAAR ID
}

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  apaarId        String   @unique
  name           String
  mobile         String
  dob            DateTime
  hashedPassword String
  createdAt      DateTime @default(now())
}

model Course {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  nqrCode        String       @unique
  name           String
  duration       Int // duration in hours
  credits        Int
  organisationId String       @db.ObjectId
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  createdAt      DateTime     @default(now())
}

